s2w0g5amtp.jpg", "price": 1400, "discountPrice": 1150, "meta": {"willArrive": "", "willArriveHint": "", "arrivalType": null, "available": true, "delivery": false, "storeIdCourierDelivery": 6415, "storeCourierLink": true, "pickup": ""}, "favorite": false, "basket": {"current": 0, "max": 50, "in_stock": 5}, "tags": [], "specifications": [{"label": "Поддерживаемые модели", "value": "Huawei Honor X7d 4G"}, {"label": "Рамка", "value": "есть"}, {"label": "Цвет рамки", "value": "черный"}, {"label": "Тип дисплея", "value": "In-Cell"}]}, {"id": 5769, "link": "/catalog/displei/displey-dlya-huawei-honor-10-lite-10i-20e-hry-lx1-hry-lx1t-v-sbore-s-tachskrinom-chernyy-standart-co/", "questionUrl": "/help/program-loyalnost/", "article": "LCD-HUW-HNR-10-LT-CP-B-CHPQLT", "name": "Дисплей для Huawei Honor 10 Lite/10i/20e (HRY-LX1/HRY-LX1T) в сборе с тачскрином Черный - (QHD, 250 Кд/м²) Стандарт (COG)", "image": "/upload/iblock/39b/0tz3of15s15naj500kgne15kxki6xo2b.jpg", "price": 700, "discountPrice": 590, "meta": {"willArrive": "", "willArriveHint": "", "arrivalType": null, "available": true, "delivery": false, "storeIdCourierDelivery": 6415, "storeCourierLink": true, "pickup": ""}, "favorite": false, "basket": {"current": 0, "max": 50, "in_stock": 13}, "tags": [{"id": 1, "color": "#75B726", "name": "COG", "tooltipContent": "\n            <div><b>COF («Chip on Flex»)</b> — чип установлен на шлейфе.</div> <br>\n<div><b>COG («Chip on Glass»)</b> — чип интегрирован в матрицу.</div> <br>\n<div>COF — изготовлены по одной технологии с оригинальными дисплеями, за счет чего дисплеи не имеют разницы в разрешении. Минус COF — более высокая цена. Этот недостаток компенсируется качеством.</div> <br>\n<div>COG — микросхема не имеет корпуса и располагается в нижней части матрицы. COG-дисплеи имеют меньшее разрешение по сравнению с COF аналогами, наиболее чувствительны к механическому воздействию.</div> <br>\n"}, {"id": 2, "color": "#FFAF00", "name": "In-Cell", "tooltipContent": "<div><b>Отличительные особенности Oled:</b></div>\n    <ul><li>высокая контрастность с глубоким черным цветом и широкие углы обзора;</li>\n    <li>поддержка всех функций дисплея, заложенных производителем;</li>\n    <li>тип и конструкция матрицы аналогичные оригинальной позволяют без проблем установить дисплей в оригинальную рамку;</li>\n    <li>отсутствие энергопотерь по сравнению с In-Cell, в котором требуется дополнительное питание для работы подсветки.</li></ul>\n    <div><b>Если Oled заменить на InCell:</b></div>\n    <ul><li>низкая цена;</li>\n    <li>имеет дополнительный поляризационный слой, который незначительно увеличивает толщину экрана и повышает рабочую температуру телефона;</li>\n    <li>изменение конструкции дисплея для некоторых моделей привело к малозаметному уменьшению размера рабочей зоны экрана.</li></ul>\n    <p>Внимание! НЕ ПРИМЕНИМО, если в устройстве изначально спроектирован InCell дисплей в конструкции.</p>"}], "specifications": [{"label": "Поддерживаемые модели", "value": "Huawei Honor 10 Lite, Huawei Honor 10i, Huawei Honor 20e"}, {"label": "Рамка", "value": "нет"}, {"label": "Тип дисплея", "value": "In-Cell"}, {"label": "Цвет дисплея", "value": "черный"}]}, {"id": 33018, "link": "/catalog/displei/displey-dlya-tecno-camon-40-pro-5g-cm7-modul-s-ramkoy-chernyy-or/", "questionUrl": "/help/program-loyalnost/", "article": "LCD-TCN-CMN-40-PR-5G-FR-B-OR", "name": "Дисплей для Tecno Camon 40 Pro 5G (CM7) модуль с рамкой Черный - OR (Full HD, 500 Кд/м²)", "image": "/upload/iblock/929/foplj0a26fpt1skgb46nbqru0s5piwge.jpg", "price": 4100, "discountPrice": 3440, "meta": {"willArrive": "", "willArriveHint": "", "arrivalType": null, "available": true, "delivery": false, "storeIdCourierDelivery": 0, "storeCourierLink": false, "pickup": ""}, "favorite": false, "basket": {"current": 0, "max": 1, "in_stock": 1}, "tags": [], "specifications": [{"label": "Поддерживаемые модели", "value": "Tecno Camon 40 Pro 5G"}, {"label": "Рамка", "value": "есть"}, {"label": "Цвет рамки", "value": "черный"}, {"label": "Тип дисплея", "value": "OLED"}]}]}