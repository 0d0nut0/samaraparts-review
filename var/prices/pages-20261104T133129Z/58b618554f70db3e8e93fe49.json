rrent": 0, "max": 50, "in_stock": 4}, "tags": [{"id": 2, "color": "#FFAF00", "name": "OLED", "tooltipContent": "<div><b>Отличительные особенности Oled:</b></div>\n    <ul><li>высокая контрастность с глубоким черным цветом и широкие углы обзора;</li>\n    <li>поддержка всех функций дисплея, заложенных производителем;</li>\n    <li>тип и конструкция матрицы аналогичные оригинальной позволяют без проблем установить дисплей в оригинальную рамку;</li>\n    <li>отсутствие энергопотерь по сравнению с In-Cell, в котором требуется дополнительное питание для работы подсветки.</li></ul>\n    <div><b>Если Oled заменить на InCell:</b></div>\n    <ul><li>низкая цена;</li>\n    <li>имеет дополнительный поляризационный слой, который незначительно увеличивает толщину экрана и повышает рабочую температуру телефона;</li>\n    <li>изменение конструкции дисплея для некоторых моделей привело к малозаметному уменьшению размера рабочей зоны экрана.</li></ul>\n    <p>Внимание! НЕ ПРИМЕНИМО, если в устройстве изначально спроектирован InCell дисплей в конструкции.</p>"}], "specifications": [{"label": "Поддерживаемые модели", "value": "Samsung S20 Ultra"}, {"label": "Рамка", "value": "есть"}, {"label": "Цвет рамки", "value": "черный"}, {"label": "Тип дисплея", "value": "OLED"}]}]}